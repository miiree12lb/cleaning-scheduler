{
  "name": "cleaning-scheduler",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:login": "wrangler d1 execute cleaning-db --local --command \"INSERT OR REPLACE INTO sessions (id, user_id, expires_at) VALUES ('test-session', 1, datetime('now', '+1 day'))\"",
    "build": "npm --prefix web run build",
    "deploy": "npm --prefix web run build && cd web && wrangler deploy --config dist/cleaning_scheduler/wrangler.json",
    "typecheck": "tsc -p .",
    "db:migrate:local": "wrangler d1 migrations apply cleaning-db --local",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miiree12lb/cleaning-scheduler.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/miiree12lb/cleaning-scheduler/issues"
  },
  "homepage": "https://github.com/miiree12lb/cleaning-scheduler#readme",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "hono": "^4.13.16"
  }
}
