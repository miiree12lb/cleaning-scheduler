{
	"name": "cleaning-scheduler",
	"main": "server/index.ts",
	"compatibility_date": "2026-11-05",
	"assets": {
		"directory": "./web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cleaning-db",
			"database_id": "25961695-4578-4731-91d9-d6c4753f5e81",
			"migrations_dir": "server/migrations"
		}
	],
	"ratelimits": [
		{
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "JOIN_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}